---
import AmbientColor from '@/components/AmbientColor.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlocksRenderer from '@/components/BlocksRenderer.astro';
import Container from '@/components/Container.astro';
import DynamicZone from '@/components/DynamicZone.astro';
import StrapiMedia from '@/components/StrapiMedia.astro';
import { LOCALES } from '@/lib/i18n';
import { fetchCollection, fetchSingle } from '@/lib/strapi';
import type { Article, Global } from '@/types/strapi';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    const articles = await fetchCollection<Article>('articles', { locale });
    for (const article of articles) {
      paths.push({
        params: { locale, slug: article.slug },
        props: { article },
      });
    }
  }
  return paths;
}

const { locale } = Astro.params as { locale: string };
const { article } = Astro.props as { article: Article };
const global = await fetchSingle<Global>('global', { locale });

const published = article.publishedAt
  ? new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : 'en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    }).format(new Date(article.publishedAt))
  : null;
---

<BaseLayout locale={locale} global={global} seo={article.seo}>
  <div class="relative overflow-hidden">
    <AmbientColor />
    <Container class="relative z-10 mt-16 lg:mt-32">
      <div class="flex items-center justify-between px-2 py-8">
        <a href={`/${locale}/blog`} class="flex items-center space-x-2">
          <svg
            class="text-muted h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M19 12H5M12 19l-7-7 7-7"></path>
          </svg>
          <span class="text-muted text-sm">Back</span>
        </a>
      </div>

      <div class="mx-auto w-full">
        {
          article.image ? (
            <StrapiMedia
              media={article.image}
              alt={article.title}
              width={800}
              height={800}
              loading="eager"
              class="aspect-square h-40 w-full rounded-3xl object-cover [mask-image:radial-gradient(circle,white,transparent)] md:h-96"
            />
          ) : (
            <div class="shadow-derek aspect-square h-40 w-full rounded-3xl bg-neutral-900 md:h-96" />
          )
        }
      </div>

      <div class="xl:relative">
        <div class="mx-auto max-w-2xl">
          <article class="pt-8 pb-8">
            {
              article.categories?.length ? (
                <div class="flex flex-wrap gap-4">
                  {article.categories.map((category) => (
                    <p class="text-muted rounded-full bg-neutral-800 px-2 py-1 text-xs font-bold capitalize">
                      {category.name}
                    </p>
                  ))}
                </div>
              ) : null
            }

            <h1
              class="mt-8 text-4xl font-bold tracking-tight text-neutral-200 sm:text-5xl"
            >
              {article.title}
            </h1>

            <BlocksRenderer
              content={article.content}
              class="prose prose-sm prose-invert mt-8 max-w-none"
            />

            {
              published && (
                <div class="mt-12 flex items-center space-x-2 border-t border-neutral-800 pt-12">
                  <div class="h-5 w-0.5 rounded-lg bg-neutral-700" />
                  <time
                    datetime={article.publishedAt}
                    class="text-muted text-sm"
                  >
                    {published}
                  </time>
                </div>
              )
            }
          </article>
        </div>
      </div>

      {
        article.dynamic_zone?.length ? (
          <DynamicZone zone={article.dynamic_zone} locale={locale} />
        ) : null
      }
    </Container>
  </div>
</BaseLayout>
