---
import ArticleView from '@/components/views/ArticleView.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { LOCALES } from '@/lib/i18n';
import { fetchCollection, fetchSingle } from '@/lib/strapi';
import type { Article, Global } from '@/types/strapi';

export async function getStaticPaths() {
  const paths = [];
  for (const locale of LOCALES) {
    const articles = await fetchCollection<Article>('articles', { locale });
    for (const article of articles) {
      paths.push({
        params: { locale, slug: article.slug },
        props: { article },
      });
    }
  }
  return paths;
}

const { locale } = Astro.params as { locale: string };
const { article } = Astro.props as { article: Article };
const global = await fetchSingle<Global>('global', { locale });
---

<BaseLayout locale={locale} global={global} seo={article.seo}>
  <ArticleView article={article} locale={locale} />
</BaseLayout>
