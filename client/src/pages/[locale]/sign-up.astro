---
import AmbientColor from '@/components/AmbientColor.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import Logo from '@/components/Logo.astro';
import { LOCALES } from '@/lib/i18n';
import { fetchSingle } from '@/lib/strapi';
import type { Global } from '@/types/strapi';

/**
 * Sign-up page.
 *
 * Strapi's navbar and footer both link to `/sign-up`, so the route has to exist
 * or the CMS renders a dead link. LaunchPad's own Next.js version of this page
 * is presentational — a form with no submit handler and decorative OAuth
 * buttons — and this port has no auth either, so it matches that.
 *
 * The difference: this one says so. A form that silently discards a password is
 * worse than one that tells you it is a demo.
 */
export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: string };
const global = await fetchSingle<Global>('global', { locale });

const inputClass =
  'h-10 w-full rounded-md border border-neutral-800 bg-charcoal pl-4 text-sm text-white placeholder-neutral-500 focus:ring-2 focus:ring-neutral-800 focus:outline-none';
---

<BaseLayout locale={locale} global={global} seo={{ metaTitle: 'Sign up' }}>
  <div class="relative overflow-hidden">
    <AmbientColor />
    <Container
      class="relative z-10 flex h-screen max-w-lg flex-col items-center justify-center"
    >
      <Logo image={global.navbar?.logo?.image} locale={locale} />

      <h1 class="my-4 text-xl font-bold md:text-4xl">Sign up for LaunchPad</h1>

      <form class="my-4 w-full" data-signup-form>
        <label class="sr-only" for="signup-email">Email address</label>
        <input
          id="signup-email"
          type="email"
          name="email"
          autocomplete="email"
          placeholder="Email Address"
          class={`${inputClass} mb-4`}
        />

        <label class="sr-only" for="signup-password">Password</label>
        <input
          id="signup-password"
          type="password"
          name="password"
          autocomplete="new-password"
          placeholder="Password"
          class={`${inputClass} mb-4`}
        />

        <button
          type="submit"
          class="w-full rounded-md bg-neutral-800 py-3 text-sm font-medium text-white shadow-[0px_1px_0px_0px_var(--color-neutral-600)_inset] transition hover:bg-neutral-700"
        >
          Sign up
        </button>

        <p
          class="mt-4 text-center text-xs text-neutral-500"
          data-signup-status
          role="status"
        >
          This demo has no authentication — the form does not submit.
        </p>
      </form>

      <div class="relative w-full py-8">
        <div class="h-px w-full rounded-t-xl bg-neutral-700"></div>
        <div class="h-px w-full rounded-b-xl bg-neutral-800"></div>
        <div
          class="absolute inset-0 m-auto flex h-5 w-5 items-center justify-center rounded-md bg-neutral-800 px-3 py-0.5 text-xs shadow-[0px_-1px_0px_0px_var(--color-neutral-700)]"
        >
          OR
        </div>
      </div>

      <div class="flex w-full flex-col gap-4 sm:flex-row">
        {
          ['GitHub', 'Google'].map((provider) => (
            <button
              type="button"
              disabled
              aria-disabled="true"
              title="Not configured in this demo"
              class="flex flex-1 items-center justify-center gap-2 rounded-md bg-white px-4 py-3 text-black shadow-[0px_1px_0px_0px_#00000040_inset] transition duration-200 disabled:cursor-not-allowed disabled:opacity-60"
            >
              <span class="text-sm">Login with {provider}</span>
            </button>
          ))
        }
      </div>
    </Container>
  </div>
</BaseLayout>

<script>
  // Prevent a navigation that would look like a failed submit.
  document.querySelectorAll('[data-signup-form]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector('[data-signup-status]');
      if (status) {
        status.textContent =
          'Not wired up — point this at your own auth provider to make it work.';
      }
    });
  });
</script>
