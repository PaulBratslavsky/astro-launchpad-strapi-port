# The Strapi backend is fetched from the LaunchPad repo by `yarn setup`.
# It is a build artifact, not source — never commit it.
/strapi/
/.launchpad-fetch/

# dependencies
node_modules/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# build output
dist/
.astro/
build/

# env files — these hold generated secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# editors / OS
.DS_Store
.vscode/
.idea/
*.pem
*.tsbuildinfo
